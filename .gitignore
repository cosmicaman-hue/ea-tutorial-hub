# Logs
*.log

# Large binaries — never commit (exceed GitHub file size limits)
# cloudflared.exe is ~51 MB (GitHub warning >50 MB)
# jdk17.zip is ~182 MB (GitHub hard reject >100 MB)
cloudflared.exe
jdk17.zip
jdk-17.0.19+10/
jdk-*/

# Scratch / diagnostic scripts (local only)
scratch/

# Local runtime data — never commit
# NOTE: public_site/credentials.json must stay TRACKED: it is deployed to
# Cloudflare Pages via the git-based Force Publish flow (contains only
# salted SHA-256 hashes of public-gate passwords, public by design).
ea_data.db
_ayush_scores_*.json
